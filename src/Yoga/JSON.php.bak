<?php

$exports['_parseJSON'] = function($payload) {
    return \json_decode($payload, false, 512, JSON_THROW_ON_ERROR);
};

if (!isset($GLOBALS['__Purs_Undefined'])) {
    $GLOBALS['__Purs_Undefined'] = new \stdClass();
}
$undefined = $GLOBALS['__Purs_Undefined'];

$exports['_undefined'] = $undefined;

function strip_undefined($data, $undef) {
    if (is_object($data)) {
        $result = new \stdClass();
        foreach ($data as $k => $v) {
            if ($v !== $undef) {
                $result->$k = strip_undefined($v, $undef);
            }
        }
        return $result;
    } elseif (is_array($data)) {
        $result = [];
        foreach ($data as $k => $v) {
            $result[$k] = strip_undefined($v, $undef);
        }
        return $result;
    }
    return $data;
}

$exports['_unsafeStringify'] = function($data) use ($undefined) {
    return \json_encode(strip_undefined($data, $undefined));
};

$exports['_unsafePrettyStringify'] = function($spaces, $data) use ($undefined) {
    return \json_encode(strip_undefined($data, $undefined), JSON_PRETTY_PRINT);
};

return $exports;
